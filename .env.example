# Copied into docker-compose.yml via variable substitution.
# Copy this file to .env and fill in real values before running docker compose up.

POSTGRES_USER=bha_user
POSTGRES_PASSWORD=bha_password
POSTGRES_DB=bha_db

SECRET_KEY=change-this-to-a-random-64-char-secret
FRONTEND_ORIGIN=http://localhost:5173

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Host-side port overrides — only needed if the defaults (5432, 8000, 5173)
# collide with something else already running on your machine. Leave unset
# to use the defaults.
# POSTGRES_HOST_PORT=5433
# BACKEND_HOST_PORT=8001
# FRONTEND_HOST_PORT=5173
