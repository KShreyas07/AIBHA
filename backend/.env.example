# App
APP_NAME=AI Business Health Analyzer
ENVIRONMENT=development
DEBUG=true
SECRET_KEY=change-this-to-a-random-64-char-secret
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# Database
DATABASE_URL=postgresql+psycopg2://bha_user:bha_password@localhost:5432/bha_db
POSTGRES_USER=bha_user
POSTGRES_PASSWORD=bha_password
POSTGRES_DB=bha_db

# CORS
FRONTEND_ORIGIN=http://localhost:5173

# AI / LLM
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL=gpt-4o-mini

# Uploads
UPLOAD_DIR=uploads
REPORTS_DIR=reports
MAX_UPLOAD_SIZE_MB=20
